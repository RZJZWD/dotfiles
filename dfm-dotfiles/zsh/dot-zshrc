# Created by newuser for 5.8

# ======================================
# ⚙️ Oh My Zsh 兼容性变量（定义你的习惯）
# ======================================
CASE_SENSITIVE="false"          # 默认：不区分大小写
HYPHEN_INSENSITIVE="true"       # 连字符和下划线互换（方便补全）
COMPLETION_WAITING_DOTS="true"  # 显示等待补全的红点
HIST_STAMPS="yyyy-mm-dd"        # 历史记录时间格式
# ENABLE_CORRECTION="true"      # 启用命令自动更正（按需）
# DISABLE_MAGIC_FUNCTIONS="true" # 禁用魔法函数（按需）
# DISABLE_LS_COLORS="true"       # 完全禁用 ls 颜色（不推荐）

# ======================================
# 📂 用户自定义补全路径
# ======================================
fpath=($HOME/.zsh/completions $fpath)

# ======================================
# 🔌 Zinit 插件管理器安装与加载
# ======================================
### Added by Zinit's installer
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# =============================================================================
# 📌 加载自定义补全注册脚本（集中管理所有手动补全）
# =============================================================================
source ~/.zsh/completions/register.zsh

# ======================================
# 📚 加载 Oh My Zsh 核心库
# ======================================
# --- 必须同步加载：补全系统、按键绑定、剪贴板、历史共享 ---
zinit snippet OMZL::completion.zsh
zinit snippet OMZL::clipboard.zsh
zinit snippet OMZL::key-bindings.zsh
zinit snippet OMZL::history.zsh

# --- 延迟加载：不影响按键与补全初始化 ---
zinit wait"1" lucid for \
    OMZL::directories.zsh \
    OMZL::functions.zsh \
    OMZL::git.zsh \
    OMZL::grep.zsh \
    OMZL::misc.zsh \
    OMZL::spectrum.zsh \
    OMZL::termsupport.zsh \
    OMZL::theme-and-appearance.zsh

# ======================================
# 🧩 官方插件（Oh My Zsh plugins）
# ======================================
# --- 必须同步加载：sudo 插件绑定 Esc-Esc 快捷键 ---
zinit snippet OMZ::plugins/sudo/sudo.plugin.zsh

# --- 延迟加载：不影响启动交互 ---
zinit wait"1" lucid for \
    OMZ::plugins/git/git.plugin.zsh \
    OMZ::plugins/copyfile/copyfile.plugin.zsh \
    OMZ::plugins/extract/extract.plugin.zsh \
    OMZP::colored-man-pages \
    OMZP::command-not-found \
    OMZP::gitignore

# ======================================
# 🧩 第三方插件（Third-party plugins）
# ======================================
# --- 必须同步加载：fzf（必须在 key-bindings 之后绑定按键）---
zinit ice from"gh-r" as"command" id-as"junegunn/fzf" \
    atload'eval "$(fzf --zsh)"'
zinit light junegunn/fzf

# --- 延迟加载：不影响启动交互 ---
# 快速目录跳转（替代 OMZ 的 z）
zinit ice lucid wait"1"
zinit light skywind3000/z.lua

# 补全定义库（在 compinit 之后）
zinit ice wait lucid
zinit light zsh-users/zsh-completions

# 自动建议
zinit ice wait lucid
zinit light zsh-users/zsh-autosuggestions

# 语法高亮务必最后
zinit ice wait lucid
zinit light zdharma-continuum/fast-syntax-highlighting

# ======================================
# 🎨 主题加载（Powerlevel10k）
# ======================================
# 加载 powerlevel10k 主题（使用浅克隆）
zinit ice depth=1
zinit light romkatv/powerlevel10k

# 加载 p10k 配置文件（如果存在）
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ======================================
# ⚙️ 杂项配置
# ======================================
export PATH="$HOME/.local/bin:$PATH"

# ===== DFM Dotfiles Manager - Start ===== #
alias dfm='/home/djs/dotfiles/DFM.sh'
# ===== DFM Dotfiles Manager - End ===== #